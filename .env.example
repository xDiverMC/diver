# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # RAHASIA — hanya di Vercel, jangan di-commit

# ── Tripay ───────────────────────────────────────────────
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_MODE=production                # sandbox | production — HARUS cocok dengan jenis API key
PUBLIC_SITE_URL=https://www.bdzone.net
USD_TO_IDR=16000                      # kurs tetap harga USD → IDR

# ── Auto-delivery (RCON server Minecraft) ────────────────
RCON_HOST=
RCON_PORT=25575
RCON_PASSWORD=
DELIVERY_MAX_ATTEMPTS=5               # opsional
# DELIVERY_FAIL_REGEX=                # opsional: pola output RCON yang dianggap gagal

# ── Notifikasi ───────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_NEW_ORDER=true         # false = hanya notif bayar/kirim
RESEND_API_KEY=
EMAIL_FROM=BDZONE <noreply@domainkamu.com>

# ── Admin & cron ─────────────────────────────────────────
CRON_SECRET=                          # string acak panjang
ADMIN_EMAILS=                         # opsional: email admin dipisah koma (batasi tombol "Kirim ulang")
TZ_OFFSET_HOURS=8                     # WITA; dipakai utk "hari ini"/"bulan ini"
